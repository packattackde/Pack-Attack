{
  "manifest_version": 3,
  "name": "Pullforge Cardmarket Automator",
  "version": "1.0.0",
  "description": "Fills Cardmarket cart from pack-attack.de admin (uses local agent + your Chrome).",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:3847/*", "http://localhost:3847/*"],
  "externally_connectable": {
    "matches": ["https://pack-attack.de/*", "https://*.pack-attack.de/*"]
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
